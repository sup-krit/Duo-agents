# Claude: either set an API key, or leave empty to reuse your Claude Code login on this machine
ANTHROPIC_API_KEY=
# Codex: either set an API key, or leave empty to reuse your `codex login`
OPENAI_API_KEY=

# Optional model overrides
CLAUDE_MODEL=
CODEX_MODEL=

# Codex does not report cost, only tokens. Set your rates to see an estimate (USD per 1M tokens).
CODEX_USD_PER_MTOK_IN=0
CODEX_USD_PER_MTOK_OUT=0

# Where run logs (events.jsonl, plan.md, review-N.md) are written
RUNS_DIR=./runs
